# Copy to .env for local use. Do not commit real secrets.

IMAGE_PROVIDER=none
MODEL_3D_PROVIDER=none

# Supported image providers:
# none, openai, polza_ai, local_comfyui, custom_http
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
POLZA_AI_API_KEY=
POLZA_AI_IMAGE_URL=
LOCAL_COMFYUI_URL=http://127.0.0.1:8188
CUSTOM_IMAGE_HTTP_URL=
CUSTOM_IMAGE_HTTP_TOKEN=

# Supported 3D providers:
# none, tripo, meshy, custom_http
TRIPO_API_KEY=
MESHY_API_KEY=
CUSTOM_MODEL_HTTP_URL=
CUSTOM_MODEL_HTTP_TOKEN=

GODOT_CLI=godot
GODOT_MCP_PORT=8765
GODOT_BRIDGE_HOST=127.0.0.1
GODOT_MCP_READ_ONLY=false
