# Copy to .env for local use. Do not commit real secrets.

IMAGE_PROVIDER=none
MODEL_3D_PROVIDER=none
AI_CHAT_PROVIDER=none

# Supported image providers:
# none, openai, polza_ai, local_comfyui, custom_http
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
POLZA_AI_API_KEY=
POLZA_AI_IMAGE_URL=
LOCAL_COMFYUI_URL=http://127.0.0.1:8188
CUSTOM_IMAGE_HTTP_URL=
CUSTOM_IMAGE_HTTP_TOKEN=

# Supported 3D providers:
# none, tripo, meshy, custom_http
TRIPO_API_KEY=
TRIPO_MODEL_VERSION=v2.5-20250123
TRIPO_TEXTURE=true
TRIPO_PBR=true
TRIPO_TEXTURE_QUALITY=standard
MESHY_API_KEY=
MESHY_QUALITY=preview
MESHY_TIMEOUT_MS=600000
CUSTOM_MODEL_HTTP_URL=
CUSTOM_MODEL_HTTP_TOKEN=

# Editor chat provider:
# none, openai_compatible
# Examples:
# - local LM Studio: AI_CHAT_BASE_URL=http://127.0.0.1:1234/v1
# - local Ollama OpenAI-compatible endpoint: AI_CHAT_BASE_URL=http://127.0.0.1:11434/v1
# - OpenAI-compatible cloud API: AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_TEMPERATURE=0.2
AI_CHAT_SYSTEM_PROMPT=You are an AI assistant embedded in the Godot editor. Give concise Godot 4.x guidance.

GODOT_CLI=godot
GODOT_MCP_PORT=8765
GODOT_BRIDGE_HOST=127.0.0.1
GODOT_MCP_READ_ONLY=false
